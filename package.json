{
  "name": "fresh-ceramics",
  "version": "1.0.0",
  "description": "Website and CMS for Fresh Ceramics",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3100",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3100",
    "seed": "tsx ./scripts/seed.ts",
    "placeholders": "tsx ./scripts/placeholders.ts",
    "import:products": "tsx ./scripts/import-products.ts",
    "import:showrooms": "tsx ./scripts/import-showrooms.ts",
    "backup": "tsx ./scripts/backup.ts",
    "export:content": "tsx ./scripts/export-content.ts",
    "check": "tsc --noEmit && playwright test"
  },
  "dependencies": {
    "@libsql/client": "0.14.0",
    "@payloadcms/db-sqlite": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "cross-env": "^7.0.3",
    "d3-geo": "^3.1.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.2.0",
    "graphql": "^16.8.1",
    "gsap": "^3.12.7",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.27",
    "lucide-react": "^1.16.0",
    "minisearch": "^7.1.2",
    "next": "15.4.11",
    "openseadragon": "^5.0.1",
    "payload": "3.91.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/d3-geo": "^3.1.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.0",
    "@types/openseadragon": "^3.0.10",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
